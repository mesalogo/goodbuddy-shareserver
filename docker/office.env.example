# Copy to .env.office in the repository root and fill the secret before starting.
# Build in ../goodbuddy-onlyoffice-server first; this image is not published to a registry.
ONLYOFFICE_IMAGE=goodbuddy/onlyoffice-server:10.0.0-169-ce9999
# Relative to docker/compose.office.yaml; keep DE and Community engine data separate.
ONLYOFFICE_DATA_ROOT=../data/onlyoffice-community
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# LAN without DNS: use http://<host-ip>:8080 above, and 0.0.0.0 below.
SHARESERVER_BIND_ADDRESS=0.0.0.0
SHARESERVER_WEB_PORT=8088
SHARESERVER_PUBLIC_URL=http://localhost:8088
OFFICE_BIND_ADDRESS=127.0.0.1
ONLYOFFICE_PORT=8080
# Keep false for Community. Extended White Label requires a licensed engine.
OFFICE_WHITE_LABEL_ENABLED=false
